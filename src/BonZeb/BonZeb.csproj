<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>BonZeb Library</Title>
    <Description>Library containing modules for online tracking and stimulation of zebrafish and other animals.</Description>
    <PackageTags>$(PackageTags) Tracking Stimulation</PackageTags>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="BonZeb.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Core" Version="2.9.0" />
    <PackageReference Include="Bonsai.Vision" Version="2.9.0" />
    <PackageReference Include="MathNet.Numerics" Version="4.15.0" />
    <PackageReference Include="OpenCV.Net" Version="3.4.2" />
  </ItemGroup>

</Project>
